# Hindsight Cloud API key (or point HINDSIGHT_API_URL at your self-hosted API)
HINDSIGHT_API_KEY=
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=northstar-oncall

# Groq model used to compose an answer from recalled memories
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: require this shared key for assistant and memory APIs
AFTERGLOW_ACCESS_KEY=
